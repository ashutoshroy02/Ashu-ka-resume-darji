# Resume-Darji — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Resume tailor + Telegram bot (required) ─────────────────────────────────
# LLM calls go through OpenRouter. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional. Default: google/gemini-2.5-flash-lite
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Optional: use any other OpenAI-compatible provider instead of OpenRouter.
# Example, Groq's free tier (key: https://console.groq.com/keys):
# GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=${GROQ_API_KEY}
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_EXTRA_BODY='{"reasoning_effort": "none"}'

# Bot token from @BotFather (used by telegram_bot.py / run_bot_hidden.py)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user id (comma-separated for several). Everyone else is ignored.
TELEGRAM_ALLOWED_USER_ID=
